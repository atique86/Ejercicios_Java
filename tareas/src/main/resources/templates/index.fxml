<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="curso.tareas.controlador.IndexControlador">
   <children>
      <Label layoutX="172.0" layoutY="38.0" text="Sistema de Tareas" textFill="#e63946">
         <font>
            <Font name="Arial Black" size="25.0" />
         </font></Label>
      <TableView fx:id="tareaTabla" layoutX="223.0" layoutY="87.0" onMouseClicked="#cargarTareaFormulario" prefHeight="200.0" prefWidth="360.0">
        <columns>
          <TableColumn fx:id="idTareaColumna" prefWidth="41.0" text="ID" />
          <TableColumn fx:id="nombreTareaColumna" prefWidth="133.0" text="Tarea" />
            <TableColumn fx:id="responsableColumna" prefWidth="103.0" text="Responsable" />
            <TableColumn fx:id="estatusColumna" prefWidth="81.0" text="Estatus" />
        </columns>
      </TableView>
      <AnchorPane layoutX="23.0" layoutY="87.0" prefHeight="200.0" prefWidth="200.0">
         <children>
            <Label layoutX="22.0" layoutY="14.0" text="Tarea">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <Label layoutX="22.0" layoutY="69.0" text="Responsable">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <Label layoutX="22.0" layoutY="127.0" text="Estatus">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Label>
            <TextField fx:id="nombreTareaTexto" layoutX="26.0" layoutY="38.0" />
            <TextField fx:id="responsableTexto" layoutX="26.0" layoutY="94.0" />
            <TextField fx:id="estatusTexto" layoutX="26.0" layoutY="152.0" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="21.0" layoutY="298.0" prefHeight="77.0" prefWidth="559.0">
         <children>
            <Button fx:id="agregarBoton" layoutX="46.0" layoutY="26.0" mnemonicParsing="false" onAction="#agregarTarea" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: #9ACD32;" text="Agregar">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="modificarBoton" layoutX="175.0" layoutY="26.0" mnemonicParsing="false" onAction="#modificarTarea" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: #1E90FF;" text="Modificar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="eliminarBoton" layoutX="306.0" layoutY="26.0" mnemonicParsing="false" onAction="#eliminarTarea" prefHeight="25.0" prefWidth="75.0" style="-fx-background-color: FF0000;" text="Eliminar" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
            <Button fx:id="limpiarBoton" layoutX="423.0" layoutY="26.0" mnemonicParsing="false" onAction="#limpiarFormulario" prefHeight="25.0" prefWidth="103.0" style="-fx-background-color: #FFD700;" text="Limpiar Forma">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font></Button>
         </children></AnchorPane>
   </children>
</AnchorPane>
